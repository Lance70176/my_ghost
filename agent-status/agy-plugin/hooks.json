  "myghost-status-hooks": {
    "PreInvocation": [
      { "type": "command", "command": "'@BIN@' working agy", "timeout": 5 }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "'@BIN@' working agy", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "'@BIN@' working agy", "timeout": 5 }] }
    ],
    "Stop": [
      { "type": "command", "command": "'@BIN@' done agy", "timeout": 5 }
    ]
  }
}
